# ==============================================================================
# MessPro Environment Configuration - Hiremat Mess (Davangere, Karnataka)
# ==============================================================================

# --- Frontend API & Backend Mode ---
# Set VITE_USE_MOCKS=true for standalone frontend testing with comprehensive in-memory mock DB
# Set VITE_USE_MOCKS=false to connect directly to the Django REST framework backend
VITE_API_URL=/api/v1
VITE_USE_MOCKS=true

# --- Razorpay Payment Gateway Keys ---
# Test Key format: rzp_test_xxxxxxxxxxxxxx | Live Key format: rzp_live_xxxxxxxxxxxxxx
VITE_RAZORPAY_KEY_ID=rzp_test_HirematMess2026
RAZORPAY_KEY_ID=rzp_test_HirematMess2026
RAZORPAY_KEY_SECRET=hiremat_secret_key_2026

# --- Firebase Cloud Messaging (Web Push & In-App Alerts) ---
VITE_FIREBASE_API_KEY=AIzaSyDemoHirematMessDavangere2026
VITE_FIREBASE_AUTH_DOMAIN=hiremat-mess.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=hiremat-mess-davangere
VITE_FIREBASE_STORAGE_BUCKET=hiremat-mess.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=987654321098
VITE_FIREBASE_APP_ID=1:987654321098:web:abcdef123456
# Optional backend service account JSON key path:
FIREBASE_SERVICE_ACCOUNT_KEY=

# --- Oracle Database Configuration (Dual Mode: Cloud ATP or SQLite) ---
# Set USE_ORACLE=True to switch from default SQLite (backend/db.sqlite3) to Oracle Cloud / Oracle DB
USE_ORACLE=False

# Option A: Oracle Cloud Infrastructure (OCI) Autonomous Database (ATP / ADW) via Cloud Wallet
# Extract your downloaded Wallet_xxxx.zip into backend/wallet/ and configure:
ORACLE_WALLET_DIR=backend/wallet
ORACLE_TNS_NAME=hirematmess_high
ORACLE_USER=ADMIN
ORACLE_PASSWORD=HirematMess#2026
ORACLE_WALLET_PASSWORD=

# Option B: Local Oracle DB (Docker / XE / 23ai)
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=FREEPDB1

# --- Mess Location & Business Info ---
VITE_MESS_NAME=Hiremat Mess
VITE_MESS_LOCATION="Anjaneya Layout 5th Cross, BIET Rd, Davangere, Karnataka 577004"
VITE_MESS_CONTACT="+91 98765 43210"
